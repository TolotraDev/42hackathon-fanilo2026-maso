{
  "name": "maso",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MASO — Module d'Authentification et de Source Originale",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "test:db": "npx supabase test db",
    "service:install": "cd services/analyse && python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt",
    "service:dev": "cd services/analyse && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "service:test": "cd services/analyse && .venv/bin/python -m pytest -q"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.4.7",
    "exifr": "^7.1.3",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.66.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}

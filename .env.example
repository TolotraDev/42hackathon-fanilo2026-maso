# Copier ce fichier en .env et remplir les valeurs (ne jamais committer .env)

# Supabase (MOD-02) — laisser vide pour le mode démonstration (comptes fictifs sur l'appareil)
# En local : valeurs affichées par « npm run db:start »
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service d'analyse Python (MOD-03)
VITE_ANALYSE_API_URL=http://localhost:8000

# Côté serveur uniquement (services/analyse, MOD-07) — jamais préfixées VITE_
# Toutes facultatives : sans elles, l'analyse correspondante est signalée « non configurée ».
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
GOOGLE_FACTCHECK_API_KEY=
HF_TOKEN=
AI_IMAGE_MODEL=umm-maybe/AI-image-detector
LLM_PROVIDER=ollama
LLM_API_KEY=
OLLAMA_URL=http://localhost:11434

# Copier ce fichier en .env et remplir les valeurs (ne jamais committer .env)

# Supabase (MOD-02) — laisser vide pour le mode démonstration (comptes fictifs sur l'appareil)
# En local : valeurs affichées par « npm run db:start »
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service d'analyse Python (MOD-03) — en ligne : l'adresse Render (docs/DEPLOIEMENT.md)
VITE_ANALYSE_API_URL=http://localhost:8000

# Côté serveur uniquement (services/analyse, MOD-07) — jamais préfixées VITE_
# Toutes facultatives : sans elles, l'analyse correspondante est signalée « non configurée ».
# En ligne : ajouter l'adresse de l'application (ex. https://maso-xxx.vercel.app), séparée par des virgules.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
GOOGLE_FACTCHECK_API_KEY=
HF_TOKEN=
AI_IMAGE_MODEL=umm-maybe/AI-image-detector

# Assistant éditorial « zéro invention » (MOD-07) : groq (recommandé, clé gratuite sur console.groq.com), gemini ou ollama.
# Sans modèle joignable, l'assistant est masqué et les modèles sans IA restent disponibles.
LLM_PROVIDER=ollama
# Clé du fournisseur choisi (groq ou gemini) ; GROQ_API_KEY / GEMINI_API_KEY sont aussi acceptées.
LLM_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
